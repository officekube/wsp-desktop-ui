{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "main": "public/electron.js",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.0",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^13.0.0",
    "@testing-library/user-event": "^13.2.1",
    "@types/jest": "^27.0.1",
    "@types/node": "^16.7.13",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.1.5",
    "react-scripts": "5.0.1",
    "typescript": "^4.4.2",
    "web-vitals": "^2.1.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build-dev": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron-dev": "concurrently \"BROWSER=none yarn start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-dev-win": "concurrently \"set BROWSER=none&& npm run start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-pack": "electron-builder -c.extraMetadata.main=build/electron.js",
    "preelectron-pack": "yarn build",
    "start-electron": "electron .",
    "download-runtimes": "node scripts/download-runtimes.js",
    "build": "npm run build-dev && npm run prepare-electron && npm run download-runtimes && electron-builder --x64 --arm64",
    "build-mac-x64": "npm run build-dev && npm run prepare-electron && npm run download-runtimes && electron-builder --mac --x64",
    "build-mac-arm64": "npm run build-dev && npm run prepare-electron && npm run download-runtimes && electron-builder --mac --arm64",
    "build-win-x64": "npm run build-dev && npm run prepare-electron && npm run download-runtimes && electron-builder --win --x64",
    "release": "npm run build-dev && npm run prepare-electron && npm run download-runtimes && electron-builder --publish always"
  },
  "build": {
    "appId": "com.wsp.app",
    "productName": "WSP Desktop UI",
    "asar": true,
    "asarUnpack": [
      "resources/runtimes/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "build/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": null
    },
    "dmg": {
      "writeUpdateInfo": false,
      "format": "UDZO"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "useZip": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "runtimeVersions": {
    "python": "3.12.0",
    "nodejs": "20.12.0",
    "robotframework": "6.1.1",
    "jupyter": "7.0.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officekube/AI-Workspace.git"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-is-dev": "^3.0.1",
    "tailwindcss": "3",
    "wait-on": "^8.0.2",
    "@octokit/rest": "^19.0.7",
    "axios": "^1.6.0",
    "extract-zip": "^2.0.1"
  }
}

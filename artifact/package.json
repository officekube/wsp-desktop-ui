{
  "name": "wsp-ui-desktop",
  "version": "1.0.0",
  "description": "WSP UI Application with bundled runtimes",
  "main": "src/main/index.js",
  "scripts": {
    "start": "react-scripts start",
    "build:react": "react-scripts build",
    "electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npm run electron\"",
    "build": "electron-builder --x64 --arm64",
    "build-mac-x64": "electron-builder --mac --x64",
    "build-mac-arm64": "electron-builder --mac --arm64",
    "build-win-x64": "electron-builder --win --x64",
    "release": "electron-builder --publish always",
    "download-runtimes": "node scripts/download-runtimes.js"
  },
  "homepage": "./",
  "build": {
    "appId": "com.aidesktop.app",
    "productName": "OfficeKube WSP Desktop UI",
    "asar": true,
    "asarUnpack": [
      "resources/runtimes/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "build/**/*",
      "package.json"
    ],
    "extends": null,
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": null
    },
    "dmg": {
      "writeUpdateInfo": false,
      "format": "UDZO"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "useZip": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "runtimeVersions": {
    "python": "3.12.0",
    "nodejs": "18.16.0",
    "robotframework": "6.1.1",
    "jupyter": "7.0.0"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^13.0.0",
    "@testing-library/user-event": "^13.2.1",
    "electron-squirrel-startup": "^1.0.0",
    "@types/jest": "^27.0.1",
    "@types/node": "^16.7.13",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.475.0",
    "react-router-dom": "^7.1.5",
    "react-scripts": "5.0.1",
    "typescript": "^4.4.2",
    "web-vitals": "^2.1.0"
  },
  "devDependencies": {
    "@octokit/rest": "^19.0.7",
    "axios": "^1.6.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "extract-zip": "^2.0.1",
    "react-scripts": "^5.0.1",
    "wait-on": "^7.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officekube/wsp-desktop-ui.git"
  },
  "author": "",
  "license": "MIT",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
